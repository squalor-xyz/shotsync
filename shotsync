#!/usr/bin/env bash
# shotsync: copy screenshots between this laptop and one or more VMs.
#
#   shotsync push [target|all]   laptop folder  -> VM remote_dir
#   shotsync pull [target|all]   VM remote_dir  -> laptop folder/from-<target>/
#   shotsync targets             list configured targets (first = default)
#
# Targets live in the `targets` file next to this script.
# Local folder: $SHOTSYNC_DIR, default ~/Pictures/shotsync.
# Nothing is ever deleted on either side.
set -euo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
targets_file="$here/targets"
local_dir="${SHOTSYNC_DIR:-$HOME/Pictures/shotsync}"

die() { echo "shotsync: $*" >&2; exit 1; }

usage() {
  sed -n '2,10s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
}

# Print "name host remote_dir" lines, skipping comments and blanks.
read_targets() {
  [[ -f "$targets_file" ]] \
    || die "no targets file: $targets_file (copy targets.example to targets and edit it)"
  grep -Ev '^[[:space:]]*(#|$)' "$targets_file" || true
}

# Resolve a target name (or "all", or empty = default) to target lines.
select_targets() {
  local want="${1:-}" all
  all="$(read_targets)" || exit 1
  [[ -n "$all" ]] || die "no targets configured in $targets_file"
  if [[ -z "$want" ]]; then
    head -n 1 <<<"$all"
  elif [[ "$want" == all ]]; then
    echo "$all"
  else
    awk -v n="$want" '$1 == n' <<<"$all" | grep . \
      || die "unknown target '$want' (see: shotsync targets)"
  fi
}

# remote_dir is a full VM-side path: /abs/path, or ~/path for the VM's home.
# "~" can't be expanded here (it's the VM's home, not ours), so turn ~/path
# into path: ssh and rsync both resolve relative paths from the VM's home.
# The quoted "~" patterns are literal on purpose.
remote_path() {
  # shellcheck disable=SC2088
  case "$1" in
    "~"|"~/") echo . ;;
    "~/"*)    echo "${1#"~/"}" ;;
    /*)       echo "$1" ;;
    *)        return 1 ;;
  esac
}

# Check rsync is installed on the VM, then run an optional remote command in
# the same ssh connection. Without rsync there, rsync itself only reports
# "connection unexpectedly closed (code 12)".
#   remote_prep <name> <host> [remote command]
remote_prep() {
  local name="$1" host="$2" rcmd="${3:-true}" rc=0
  # shellcheck disable=SC2029  # $rcmd is meant to expand on this side
  ssh "$host" "command -v rsync >/dev/null || exit 3; $rcmd" || rc=$?
  case "$rc" in
    0) ;;
    3) die "rsync is not installed on $host (target '$name'); install it on the VM" ;;
    *) die "ssh to $host (target '$name') failed (exit $rc)" ;;
  esac
}

push_one() {
  local name="$1" host="$2" dir="$3" path newest
  path="$(remote_path "$dir")"
  [[ -d "$local_dir" ]] || die "local folder not found: $local_dir"
  echo "==> push $name ($host:$dir)"
  remote_prep "$name" "$host" "mkdir -p -- $path"
  rsync -av --exclude 'from-*/' "$local_dir/" "$host:$path/"
  newest="$(find "$local_dir" -maxdepth 1 -type f ! -name '.*' -print0 \
    | xargs -0 ls -t 2>/dev/null | head -n 1)"
  if [[ -n "$newest" ]]; then
    echo "newest on $name: \"${dir%/}/$(basename "$newest")\""
  fi
}

pull_one() {
  local name="$1" host="$2" dir="$3" path dest="$local_dir/from-$1"
  path="$(remote_path "$dir")"
  echo "==> pull $name ($host:$dir -> $dest)"
  remote_prep "$name" "$host"
  mkdir -p "$dest"
  rsync -av "$host:$path/" "$dest/"
}

cmd="${1:-}"
case "$cmd" in
  push|pull)
    selected="$(select_targets "${2:-}")"
    while read -r name host dir _; do
      [[ -n "${dir:-}" ]] || die "bad line for '$name' in $targets_file (need: name host remote_dir)"
      remote_path "$dir" >/dev/null \
        || die "bad remote_dir '$dir' for '$name' in $targets_file (must start with / or ~/)"
      "${cmd}_one" "$name" "$host" "$dir" </dev/null
    done <<<"$selected"
    ;;
  targets)
    read_targets
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
